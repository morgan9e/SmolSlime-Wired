# Seeed XIAO ESP32-S3 (8 MB flash). The USB port is TinyUSB's (CDC console + HID like the nRF
# receiver); ESP_LOG goes to UART0 (pins), unused.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096

# HID reports every millisecond (link_usb.c hid_task)
CONFIG_FREERTOS_HZ=1000

# Controller activities: the connections, scanning and one being set up
CONFIG_BT_CTRL_BLE_MAX_ACT=10
