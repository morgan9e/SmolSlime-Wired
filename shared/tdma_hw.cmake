# Keep SDK installations untouched. Add one guarded hook to the build's ESB
# copy: the ordinary EGU start can be deferred after ESB prepares its state.
# Fail closed if Nordic changes that integration point.
if(CONFIG_RADIO_TDMA_HW)
  target_sources(app PRIVATE ${CMAKE_CURRENT_LIST_DIR}/tdma_hw.c)
  set(TDMA_SHARED_DIR ${CMAKE_CURRENT_LIST_DIR})
  function(tdma_patch_esb)
    set(esb_target "..__nrf__subsys__esb")
    if(NOT TARGET ${esb_target})
      message(FATAL_ERROR "TDMA: ESB library target changed; review SDK adapter")
    endif()
    get_target_property(esb_dir ${esb_target} SOURCE_DIR)
    get_target_property(esb_sources ${esb_target} SOURCES)
    file(READ "${esb_dir}/esb.c" original)
    set(needle "static void radio_start(void)\n{")
    string(REGEX MATCHALL "static void radio_start\\(void\\)\n\\{" matches "${original}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "TDMA: radio_start hook changed; review SDK adapter")
    endif()
    set(hook "${needle}\n\t/* Slime TDMA: ESB state/ACK setup is complete; delay only its start. */\n\textern bool tdma_hw_defer_start(uint32_t task);\n\tif (tdma_hw_defer_start(nrf_egu_task_address_get(ESB_EGU, ESB_EGU_TASK))) return;")
    string(REPLACE "${needle}" "${hook}" patched "${original}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/tdma_esb.c")
    file(WRITE "${output}" "${patched}")
    set(replaced FALSE)
    set(new_sources)
    foreach(source IN LISTS esb_sources)
      if(source STREQUAL "esb.c" OR source STREQUAL "${esb_dir}/esb.c")
        list(APPEND new_sources "${output}")
        set(replaced TRUE)
      else()
        list(APPEND new_sources "${source}")
      endif()
    endforeach()
    if(NOT replaced)
      message(FATAL_ERROR "TDMA: cannot locate ESB source in library")
    endif()
    set_property(TARGET ${esb_target} PROPERTY SOURCES "${new_sources}")
    target_include_directories(${esb_target} PRIVATE "${esb_dir}")
  endfunction()
  cmake_language(DEFER CALL tdma_patch_esb)
endif()
