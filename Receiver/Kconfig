choice
	prompt "Status LED color mapping"
    default LED_TRI_COLOR

config LED_RGB_COLOR
    bool "Use RGB color mapping"
    help
        Use RGB or RG color mapping for LED status if available.

config LED_TRI_COLOR
    bool "Use default color mapping"
    help
        Use the default color mapping for LED status.

endchoice

menu "Status LED default status color"
    depends on LED_RGB_COLOR

config LED_DEFAULT_COLOR_R
    int "Red value"
    range 0 10000
    default 4000
    depends on LED_RGB_COLOR
    help
        Red color for default status.
        Valid range is 0 to 10000.

config LED_DEFAULT_COLOR_G
    int "Green value"
    range 0 10000
    default 6000
    depends on LED_RGB_COLOR
    help
        Green color for default status.
        Valid range is 0 to 10000.

config LED_DEFAULT_COLOR_B
    int "Blue value"
    range 0 10000
    default 0
    depends on LED_RGB_COLOR
    help
        Blue color for default status.
        Valid range is 0 to 10000.

endmenu

config PACKET_LOG
    bool "Link diagnostics and packet log"
    default y
    help
        "diag on" on the console logs radio link diagnostics every interval: frames received and
        lost per tracker (from the frame sequence numbers), repeats, longest silence, RSSI, the
        radio's good/bad CRC counts and the channel's noise floor. Always logged: packets dropped
        by the receiver (unknown id, bad checksum, out of sequence) and trackers gone silent.

config PACKET_LOG_INTERVAL_MS
    int "Log interval (ms)"
    depends on PACKET_LOG
    range 100 60000
    default 1000

config PACKET_LOG_ORIENTATION
    bool "Log each tracker's orientation and packet rate every interval"
    depends on PACKET_LOG
    help
        "Tracker 2 (3CA1B2C4D5E6): orientation X 12.3 Y -4.5 Z 170.2 deg, 98 pkt/s, RSSI ..."
        while "diag" is off.

# "diag on" logs a block of lines every interval; the default 1 KB drops some of them.
config LOG_BUFFER_SIZE
    default 4096 if PACKET_LOG && !SOC_NRF52820

config RECEIVER_BLE
    bool "BLE receiver mode"
    default y if SOC_NRF52840
    select BT
    select BT_CENTRAL
    select BT_GATT_CLIENT
    select BT_GATT_DM
    select ESB_DYNAMIC_INTERRUPTS
    select MPSL_DYNAMIC_INTERRUPTS
    help
        Builds a BLE central in beside ESB, for trackers in BLE mode (src/connection/ble.c). The
        receiver_ble setting (console: ble on|off) picks one at boot: the radio runs either ESB
        or BLE, never both; the USB HID output is the same. Changing it reboots the receiver.
        As the tracker (TRACKER_BLE): MPSL keeps its default clock control in both modes and
        stays idle in ESB mode, where ESB takes the radio interrupt over.

if RECEIVER_BLE

# Six trackers and spares
config BT_MAX_CONN
    default 8

# Each connection 1500 us in the interval (ble.c: 10 ms for six, 12.5 ms for eight): two
# notification exchanges (the controller budgets 27-byte packets both ways, ~0.6 ms each on 2M,
# so 1200 us fitted one); connection event extension gives more while the others leave time
config BT_CTLR_SDC_MAX_CONN_EVENT_LEN_DEFAULT_OVERRIDE
    default y

config BT_CTLR_SDC_MAX_CONN_EVENT_LEN_DEFAULT
    default 1500

choice BT_CTLR_TX_PWR
    default BT_CTLR_TX_PWR_PLUS_8
endchoice

# Each link's PHY in the console's ble status
config BT_USER_PHY_UPDATE
    default y

# HCI Read RSSI, for the RSSI in the HID packets (off by default in the SoftDevice Controller)
config BT_CTLR_CONN_RSSI
    default y

# the BLE host runs parts on the system workqueue (upstream default 1 KB)
config SYSTEM_WORKQUEUE_STACK_SIZE
    default 2048

endif

# LF clock: synthesized from the HF crystal as upstream (no 32 kHz crystal on the Dongle), but
# BLE needs a calibrated RC oscillator under MPSL (500 ppm)
choice CLOCK_CONTROL_NRF_SOURCE
    default CLOCK_CONTROL_NRF_K32SRC_RC if RECEIVER_BLE
    default CLOCK_CONTROL_NRF_K32SRC_SYNTH
endchoice

source "Kconfig.zephyr"
