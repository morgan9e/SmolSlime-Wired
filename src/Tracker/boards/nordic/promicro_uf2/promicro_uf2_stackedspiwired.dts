// Stacked SPI tracker (SmolSlime) with the wired ankle link. One image for every tracker:
// both UARTs below use deferred init, and src/connection/wired.c starts exactly one of them
// at boot, depending on the connection_over_uart setting:
//   wired mode (setting on):  uart0, TX on P1.04 (D8), radio off
//   relay mode (setting off): uart1, RX on P1.04 (D8), started on the first edge
// D9 (P1.06) is driven low in both modes as the link's ground reference.
// Straight cable: D8 <-> D8 (data), D9 <-> D9 (ground). A 470R-1k series resistor on D8 makes a
// misconfiguration (both ends sending) harmless.
// The ground wire is only the UART signal reference; each tracker keeps its own battery.
// D0-D7 and D14 are taken on the SmolSlime stack; these pins are "low frequency I/O only".
// That is harmless on the ankle (radio off); on the relay, compare its gap statistics
// while relaying against not relaying.

/dts-v1/;
#include "promicro_uf2_stackedspi.dts"

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
			low-power-enable;
		};
	};

	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 4)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 4)>;
			bias-pull-up;
			// no low-power-enable: the input must stay connected for the wake edge
		};
	};
};

/ {
	chosen {
		slimenrf,wired-tx-uart = &uart0;
		slimenrf,wired-rx-uart = &uart1;
	};

	zephyr,user {
		// P1.04 watched as a GPIO while the relay's UART is off, to wake it.
		wired-gpios = <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		// P1.06 (D9) driven low as the link's ground reference (signal return only, not power).
		wired-gnd-gpios = <&gpio1 6 0>;
	};
};

// Detect the first edge with the low-power PORT/SENSE mechanism instead of a GPIOTE channel.
&gpio1 {
	sense-edge-mask = <(1 << 4)>;
};

// Ankle role: transmit only. i2c0 is deleted by the stacked SPI build, so uart0 is free.
&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	zephyr,deferred-init;
	current-speed = <460800>;
	disable-rx;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

// Relay role: receive only.
&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	zephyr,deferred-init;
	current-speed = <460800>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};
