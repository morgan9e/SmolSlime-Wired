# Common defaults. Target-specific values live in sdkconfig.defaults.<target>.
# Default target: Seeed XIAO ESP32-C6. Build the S3 with -D IDF_TARGET=esp32s3 (see README).
CONFIG_IDF_TARGET="esp32c6"

# Console on the native USB port, so UART0 pins stay free.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# One UDP socket per tracker plus stats.
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

CONFIG_UART_ISR_IN_IRAM=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
