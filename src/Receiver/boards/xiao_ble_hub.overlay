// Seeed XIAO nRF52840 (also the Sense) as the receiver for the ESP32 hub: the tracker
// packets go out of D6 (P1.11) as the UART mirror, 1 Mbaud TX only. Wire XIAO D6 to the hub's
// D7 plus GND. Added on top of boards/xiao_ble.overlay by "make receiver-xiao".
// SPDX-License-Identifier: Apache-2.0

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 11)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 11)>;
			low-power-enable;
		};
	};
};

/ {
	chosen {
		slimenrf,hub-uart = &uart0;
	};
};

&uart0 {
	status = "okay";
	current-speed = <1000000>;
	/delete-property/ rx-pin;
};
