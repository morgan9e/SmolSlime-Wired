From b78950963554cb32130115f6b9cee7f7ff7a0ac0 Mon Sep 17 00:00:00 2001
From: "Morgan J." <me@morgan.kr>
Date: Sat, 10 Oct 2026 10:35:01 +0900
Subject: [PATCH] Link diagnostics on the console (diag on)

Stock receiver plus the link diagnostics of the SlimeVR-Hub fork, without
its UART mirror, pairing changes or settings. Receiving, filtering and HID
output are unchanged; the hooks only count.

- diag [on|off] (off at boot): every second, per tracker, frames received
  and lost (from the frame sequence numbers, before any filter), repeats
  (missed ACKs), late frames, longest silence, RSSI average and worst, and a
  timeline of 50 ms slots; for the radio, good/bad CRC counts (TIMER3/4
  counting RADIO events through PPI) and the channel's noise floor (RSSI
  sampled at 1 kHz while listening); each silence that lost frames.
- Always: packets dropped by the receiver (unknown id, bad checksum, out of
  sequence, repeats) and stored trackers silent for 10 s.
- CONFIG_PACKET_LOG_ORIENTATION (off): per-tracker orientation lines.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Kconfig              |  26 +++
 src/connection/esb.c |   8 +
 src/console.c        |  27 +++
 src/hid.c            |   2 +
 src/packet_log.c     | 542 +++++++++++++++++++++++++++++++++++++++++++
 src/packet_log.h     |  62 +++++
 6 files changed, 667 insertions(+)
 create mode 100644 src/packet_log.c
 create mode 100644 src/packet_log.h

diff --git a/Kconfig b/Kconfig
index 1af7eda..d909723 100644
--- a/Kconfig
+++ b/Kconfig
@@ -52,4 +52,30 @@ config LED_DEFAULT_COLOR_B
 
 endmenu
 
+config PACKET_LOG
+    bool "Link diagnostics and packet log"
+    default y
+    help
+        "diag on" on the console logs radio link diagnostics every interval: frames received and
+        lost per tracker (from the frame sequence numbers), repeats, longest silence, RSSI, the
+        radio's good/bad CRC counts and the channel's noise floor. Always logged: packets dropped
+        by the receiver (unknown id, bad checksum, out of sequence) and trackers gone silent.
+
+config PACKET_LOG_INTERVAL_MS
+    int "Log interval (ms)"
+    depends on PACKET_LOG
+    range 100 60000
+    default 1000
+
+config PACKET_LOG_ORIENTATION
+    bool "Log each tracker's orientation and packet rate every interval"
+    depends on PACKET_LOG
+    help
+        "Tracker 2 (3CA1B2C4D5E6): orientation X 12.3 Y -4.5 Z 170.2 deg, 98 pkt/s, RSSI ..."
+        while "diag" is off.
+
+# "diag on" logs a block of lines every interval; the default 1 KB drops some of them.
+config LOG_BUFFER_SIZE
+    default 4096 if PACKET_LOG && !SOC_NRF52820
+
 source "Kconfig.zephyr"
