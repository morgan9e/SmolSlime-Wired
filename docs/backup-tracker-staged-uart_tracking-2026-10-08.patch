index 0000000..bbdb60e
--- /dev/null
+++ b/tools/uart_tracking_decode.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Decode tracking frames sent by CONFIG_CONNECTION_OVER_UART.
+
+Frame: 0xA5 0x5A <len> <payload[len]>
+Payload (len 21): 16 byte tracker packet, CRC32-K/4.2 of the packet (LE), sequence number.
+
+Usage:
+    uart_tracking_decode.py COM5            (needs pyserial: pip install pyserial)
+    uart_tracking_decode.py /dev/ttyUSB0 --baud 460800
+    uart_tracking_decode.py capture.bin     (decode a raw capture file)
+"""
+import argparse
+import math
+import os
+import struct
+import sys
+
+SYNC = b"\xa5\x5a"
+CRC_POLY = 0x93A409EB
+CRC_SEED = 0x93A409EB
+
+
+def crc32_k_4_2(data, crc=CRC_SEED):
+    for b in data:
+        crc ^= b << 24
+        for _ in range(8):
+            crc = ((crc << 1) ^ CRC_POLY) if crc & 0x80000000 else (crc << 1)
+            crc &= 0xFFFFFFFF
+    return crc
+
+
+def q_iem(v):
+    """Inverse of the firmware's exponential map (util.c q_iem), returns wxyz."""
+    d = v[0] * v[0] + v[1] * v[1] + v[2] * v[2]
+    inv_sqrt_d = 1 / math.sqrt(d + 1e-6)
+    a = (math.pi / 2) * d * inv_sqrt_d
+    k = math.sin(a) * inv_sqrt_d
+    return (math.cos(a), k * v[0], k * v[1], k * v[2])
+
+
+def decode_q_buf(raw):
+    q_buf = struct.unpack_from("<I", raw)[0]
+    v = (
+        (q_buf & 1023) / (1 << 10),
+        ((q_buf >> 10) & 2047) / (1 << 11),
+        ((q_buf >> 21) & 2047) / (1 << 11),
+    )
+    return q_iem([x * 2 - 1 for x in v])
+
+
+def fmt_q(q):
+    return "q(w=%.4f x=%.4f y=%.4f z=%.4f)" % q
+
+
+def fmt_v(name, v):
+    return "%s(%.3f %.3f %.3f)" % ((name,) + tuple(v))
+
+
+def decode_batt(batt, batt_v):
+    if batt == 0:
+        return "batt=none"
+    pct = "full" if batt == 255 else "%d%%" % (batt & 0x7F)
+    return "batt=%s %.2fV" % (pct, (batt_v + 245) / 100)
+
+
+def decode_temp(t):
+    return "temp=none" if t == 0 else "temp=%.1fC" % ((t - 128) / 2 + 25)
+
+
+def decode_packet(p):
+    t, tid = p[0], p[1]
+    head = "id=%d type=%d" % (tid, t)
+    if t == 0:
+        date = struct.unpack_from("<H", p, 10)[0]
+        return "%s info %s %s board=%d mcu=%d imu=%d mag=%d fw=%d.%d.%d (%04d-%02d-%02d)" % (
+            head, decode_batt(p[2], p[3]), decode_temp(p[4]), p[5], p[6], p[8], p[9],
+            p[12], p[13], p[14], (date >> 9) + 2020, (date >> 5) & 15, date & 31)
+    if t in (1, 4):
+        x, y, z, w = (v / (1 << 15) for v in struct.unpack_from("<4h", p, 2))
+        if t == 1:
+            extra = fmt_v("lin_a", (v / (1 << 7) for v in struct.unpack_from("<3h", p, 10)))
+        else:
+            extra = fmt_v("mag", (v / (1 << 10) for v in struct.unpack_from("<3h", p, 10)))
+        return "%s %s %s" % (head, fmt_q((w, x, y, z)), extra)
+    if t in (2, 7):
+        a = fmt_v("lin_a", (v / (1 << 7) for v in struct.unpack_from("<3h", p, 9)))
+        q = fmt_q(decode_q_buf(p[5:9]))
+        if t == 2:
+            return "%s %s %s %s %s" % (head, q, a, decode_batt(p[2], p[3]), decode_temp(p[4]))
+        return "%s %s %s button=%d sleep=%dms" % (head, q, a, p[2], struct.unpack_from("<H", p, 3)[0])
+    if t == 3:
+        return "%s status svr=%d status=%d" % (head, p[2], p[3])
+    if t == 5:
+        runtime = struct.unpack_from("<q", p, 2)[0]
+        return "%s runtime=%s" % (head, "unknown" if runtime < 0 else "%.1fmin" % (runtime / 60e6))
+    if t == 6:
+        return "%s button=%d sleep=%dms" % (head, p[2], struct.unpack_from("<H", p, 3)[0])
+    if t == 255:
+        addr = int.from_bytes(p[2:8], "little")
+        return "%s addr=%012X" % (head, addr)
+    return "%s unknown %s" % (head, p.hex())
+
+
+class Decoder:
+    def __init__(self):
+        self.buf = bytearray()
+        self.bad_crc = 0
+
+    def feed(self, data):
+        self.buf += data
+        while True:
+            i = self.buf.find(SYNC)
+            if i < 0:
+                del self.buf[:-1]  # keep a possible partial sync byte
+                return
+            del self.buf[:i]
+            if len(self.buf) < 3:
+                return
+            n = self.buf[2]
+            if len(self.buf) < 3 + n:
+                return
+            payload = bytes(self.buf[3:3 + n])
+            if n >= 20 and struct.unpack_from("<I", payload, 16)[0] != crc32_k_4_2(payload[:16]):
+                self.bad_crc += 1
+                del self.buf[:1]  # false sync, resync on next byte
+                continue
+            del self.buf[:3 + n]
+            yield payload
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("port", help="serial port, or a file with a raw capture")
+    ap.add_argument("--baud", type=int, default=460800)
+    ap.add_argument("--raw", action="store_true", help="print payload hex instead of decoding")
+    args = ap.parse_args()
+
+    if os.path.isfile(args.port):
+        src = open(args.port, "rb")
+        read = lambda: src.read(4096)
+    else:
+        try:
+            import serial
+        except ImportError:
+            sys.exit("pyserial is required to read a serial port: pip install pyserial")
+        src = serial.Serial(args.port, args.baud, timeout=0.1)
+        read = lambda: src.read(src.in_waiting or 1)
+
+    dec = Decoder()
+    try:
+        while True:
+            data = read()
+            if not data:
+                if not hasattr(src, "in_waiting"):
+                    break  # end of file
+                continue
+            for payload in dec.feed(data):
+                seq = payload[20] if len(payload) > 20 else None
+                line = payload.hex() if args.raw else decode_packet(payload[:16])
+                print("seq=%3s %s" % (seq, line), flush=True)
+    except KeyboardInterrupt:
+        pass
+    if dec.bad_crc:
+        print("CRC errors: %d" % dec.bad_crc, file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
