+	FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+	AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+	LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+	OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+	THE SOFTWARE.
+*/
+#include "globals.h"
+#include "connection.h"
+#include "uart_tracking.h"
+
+#include <string.h>
+#include <zephyr/kernel.h>
+
+#if CONFIG_CONNECTION_OVER_UART
+
+#include <soc.h>
+#include <zephyr/drivers/uart.h>
+#include <zephyr/sys/ring_buffer.h>
+#include <zephyr/sys/crc.h>
+
+#if !DT_HAS_CHOSEN(slimenrf_tracking_uart)
+#error "CONFIG_CONNECTION_OVER_UART requires a \"slimenrf,tracking-uart\" chosen node"
+#endif
+
+#define TRACKING_UART_NODE DT_CHOSEN(slimenrf_tracking_uart)
+
+BUILD_ASSERT(DT_NODE_HAS_STATUS(TRACKING_UART_NODE, okay), "\"slimenrf,tracking-uart\" UART is not enabled");
+
+static const struct device *const uart_dev = DEVICE_DT_GET(TRACKING_UART_NODE);
+
+RING_BUF_DECLARE(uart_tx_rb, CONFIG_CONNECTION_UART_BUFFER_SIZE);
+static struct k_spinlock uart_tx_lock;
+
+static bool uart_ready = false;
+static uint32_t dropped_frames = 0;
+static int64_t last_addr_time = 0;
+static int64_t last_dropped_log_time = 0;
+
+#define DROPPED_FRAME_LOG_INTERVAL 5000
+
+LOG_MODULE_REGISTER(uart_tracking, LOG_LEVEL_INF);
+
+static void uart_tracking_isr(const struct device *dev, void *user_data)
+{
+	ARG_UNUSED(user_data);
+
+	if (!uart_irq_update(dev))
+		return;
+
+	if (uart_irq_tx_ready(dev))
+	{
+		k_spinlock_key_t key = k_spin_lock(&uart_tx_lock);
+		uint8_t *data;
+		uint32_t size = ring_buf_get_claim(&uart_tx_rb, &data, CONFIG_CONNECTION_UART_BUFFER_SIZE);
+		if (size == 0)
+		{
+			ring_buf_get_finish(&uart_tx_rb, 0);
+			uart_irq_tx_disable(dev); // nothing left to send
+		}
+		else
+		{
+			int sent = uart_fifo_fill(dev, data, size);
+			ring_buf_get_finish(&uart_tx_rb, sent > 0 ? sent : 0);
+		}
+		k_spin_unlock(&uart_tx_lock, key);
+	}
+}
+
+static int uart_tracking_init(void)
+{
+	if (!device_is_ready(uart_dev))
+	{
+		LOG_ERR("Tracking UART not ready");
+		return -ENODEV;
+	}
+	int err = uart_irq_callback_user_data_set(uart_dev, uart_tracking_isr, NULL);
+	if (err)
+	{
+		LOG_ERR("Failed to set UART callback: %d", err);
+		return err;
+	}
+	uart_ready = true;
+	LOG_INF("Tracking UART: %s", uart_dev->name);
+	return 0;
+}
+
+SYS_INIT(uart_tracking_init, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
+
+static void uart_tracking_queue(const uint8_t *payload, uint8_t len)
+{
+	const uint8_t header[3] = {UART_TRACKING_SYNC_0, UART_TRACKING_SYNC_1, len};
+	k_spinlock_key_t key = k_spin_lock(&uart_tx_lock);
+	if (ring_buf_space_get(&uart_tx_rb) < sizeof(header) + len)
+	{
+		dropped_frames++; // only queue complete frames
+	}
+	else
+	{
+		ring_buf_put(&uart_tx_rb, header, sizeof(header));
+		ring_buf_put(&uart_tx_rb, payload, len);
+	}
+	k_spin_unlock(&uart_tx_lock, key);
+	uart_irq_tx_enable(uart_dev);
+}
+
+//|b0      |b1      |b2      |b3      |b4      |b5      |b6      |b7      |b8      |b9      |b10     |b11     |b12     |b13     |b14     |b15     |b16-b19 |b20     |
+//|255     |id      |device_addr                                          |resv-------------------------------------------------------------------|crc32   |seq (0) |
+static void uart_tracking_write_addr(void)
+{
+	uint8_t data[21] = {0};
+	data[0] = 255; // same as receiver packet 0, associate id and tracker address
+	data[1] = connection_get_id();
+	uint64_t *addr = (uint64_t *)NRF_FICR->DEVICEADDR; // Use device address as unique identifier (although it is not actually guaranteed, see datasheet)
+	memcpy(&data[2], addr, 6);
+	uint32_t crc = crc32_k_4_2_update(0x93a409eb, data, 16);
+	memcpy(&data[16], &crc, sizeof(crc));
+	data[20] = 0; // sequence 0 is not checked
+	uart_tracking_queue(data, sizeof(data));
+}
+#endif
+
+void uart_tracking_write(const uint8_t *payload, uint8_t len)
+{
+#if CONFIG_CONNECTION_OVER_UART
+	if (!uart_ready)
+		return;
+	if (CONFIG_CONNECTION_UART_ADDR_INTERVAL > 0 && k_uptime_get() - last_addr_time >= CONFIG_CONNECTION_UART_ADDR_INTERVAL)
+	{
+		last_addr_time = k_uptime_get();
+		uart_tracking_write_addr();
+	}
+	uart_tracking_queue(payload, len);
+	if (dropped_frames && k_uptime_get() - last_dropped_log_time > DROPPED_FRAME_LOG_INTERVAL)
+	{
+		LOG_WRN("Dropped UART frames: %u", dropped_frames);
+		dropped_frames = 0;
+		last_dropped_log_time = k_uptime_get();
+	}
+#endif
+}
