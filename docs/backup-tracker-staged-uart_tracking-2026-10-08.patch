+// Copyright (c) 2024 Nordic Semiconductor ASA
+// SPDX-License-Identifier: Apache-2.0
+
+/dts-v1/;
+#include "promicro_uf2_stackedspi.dts"
+
+// Tracking data output, TX only on P0.29 (right side, next to P0.02)
+// P0.29 is not used by the stacked SPI module, change the pin here if needed
+
+&pinctrl {
+	uart0_default: uart0_default {
+		group1 {
+			psels = <NRF_PSEL(UART_TX, 0, 29)>;
+		};
+	};
+
+	uart0_sleep: uart0_sleep {
+		group1 {
+			psels = <NRF_PSEL(UART_TX, 0, 29)>;
+			low-power-enable;
+		};
+	};
+};
+
+/ {
+	chosen {
+		slimenrf,tracking-uart = &uart0;
+	};
+};
+
+&uart0 {
+	compatible = "nordic,nrf-uarte";
+	status = "okay";
+	current-speed = <460800>;
+	disable-rx;
+	pinctrl-0 = <&uart0_default>;
+	pinctrl-1 = <&uart0_sleep>;
+	pinctrl-names = "default", "sleep";
+};
